# Supabase (leave unset to run entirely on the local mock adapter — see src/services/adapter)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Payments (Stripe) — not wired to a real processor yet; checkout runs in a labelled test/mock mode
# until a real publishable key is supplied. Never put a secret key in a VITE_ variable.
VITE_STRIPE_PUBLISHABLE_KEY=

# Feature flag: force the mock adapter even if Supabase vars above are set (useful for local dev/demo)
VITE_FORCE_MOCK_BACKEND=false
